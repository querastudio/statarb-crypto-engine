# ─────────────────────────────────────────────────────────────────────────────
# StatArb Crypto Engine — Environment Variables
# Copy to .env.local for local dev, and set the same keys in Vercel project settings.
# DO NOT commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Exchange / data source ───────────────────────────────────────────────────
# Public OHLCV data only — no API key required for price data.
EXCHANGE=binance
QUOTE_ASSET=USDT

# ── Supabase (persistence; Vercel is stateless) ──────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon (public) key — used by the browser/dashboard for reads
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — SERVER ONLY (cron writes). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram alerts (optional) ───────────────────────────────────────────────
TELEGRAM_ALERT=yes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cron protection ──────────────────────────────────────────────────────────
# Random string. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Strategy parameters (override defaults; all optional) ────────────────────
# Universe size (number of most-liquid symbols to scan)
UNIVERSE_SIZE=30
# OHLCV timeframe used for analysis
TIMEFRAME=1h
# Number of bars of history to fetch per symbol
LOOKBACK_BARS=720

# Pair discovery thresholds
MIN_ABS_CORRELATION=0.7
ADF_PVALUE_MAX=0.05
# Benjamini-Hochberg FDR: max fraction of pairs that are false positives (0.10 = 10%)
FDR_ALPHA=0.10
HALF_LIFE_MIN_BARS=1
HALF_LIFE_MAX_BARS=30
HURST_MAX=0.5

# Signal thresholds
ZSCORE_WINDOW=60
ENTRY_THRESHOLD=2.0
EXIT_THRESHOLD=0.5
STOP_THRESHOLD=3.5

# Risk
RISK_PER_TRADE=0.01
MAX_CONCURRENT_POSITIONS=10

# Backtest costs
FEE_PER_LEG=0.0004
SLIPPAGE=0.0005

# ── Auto-trading (Bybit USDT Perpetuals) ─────────────────────────────────────
# MASTER KILL SWITCH. Must be "yes" for the executor to do anything. Default no.
TRADING_ENABLED=no
# paper  = log intended orders only, no API calls (safest — start here)
# testnet= real orders on Bybit Testnet (fake money, real API)
# live   = real money
TRADING_MODE=paper
# Equity (USDT) used to size positions in paper mode (no wallet to query).
PAPER_EQUITY=1000
# Leverage per leg. 1 = no leverage (lowest liquidation risk). Keep low.
TRADING_LEVERAGE=1
# Cap each trade's gross notional (both legs summed) to this fraction of equity.
MAX_NOTIONAL_FRACTION=0.5
# Minimum order value (USDT) per leg — below this Bybit rejects the order.
MIN_ORDER_NOTIONAL=5
# Skip opening NEW positions when the market regime is DANGER. Default yes.
REGIME_FILTER_LIVE=yes

# Bybit API keys — create at bybit.com (or testnet.bybit.com) → API Management.
# REQUIRED scopes: Contract/Derivatives → Orders + Positions, and Wallet (read).
# Restrict to your server IP if possible. NEVER commit real keys.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# yes = use Bybit Testnet endpoints (recommended to start); no = mainnet (real $)
BYBIT_TESTNET=yes
