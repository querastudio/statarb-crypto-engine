# ─────────────────────────────────────────────────────────────────────────────
# StatArb Crypto Engine — Environment Variables
# Copy to .env.local for local dev, and set the same keys in Vercel project settings.
# DO NOT commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Exchange / data source ───────────────────────────────────────────────────
# Public OHLCV data only — no API key required for price data.
EXCHANGE=binance
QUOTE_ASSET=USDT

# ── Supabase (persistence; Vercel is stateless) ──────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon (public) key — used by the browser/dashboard for reads
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — SERVER ONLY (cron writes). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram alerts (optional) ───────────────────────────────────────────────
TELEGRAM_ALERT=yes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cron protection ──────────────────────────────────────────────────────────
# Random string. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Strategy parameters (override defaults; all optional) ────────────────────
# Universe size (number of most-liquid symbols to scan)
UNIVERSE_SIZE=30
# OHLCV timeframe used for analysis
TIMEFRAME=1h
# Number of bars of history to fetch per symbol
LOOKBACK_BARS=720

# Pair discovery thresholds
MIN_ABS_CORRELATION=0.7
ADF_PVALUE_MAX=0.05
HALF_LIFE_MIN_BARS=1
HALF_LIFE_MAX_BARS=30
HURST_MAX=0.5

# Signal thresholds
ZSCORE_WINDOW=60
ENTRY_THRESHOLD=2.0
EXIT_THRESHOLD=0.5
STOP_THRESHOLD=3.5

# Risk
RISK_PER_TRADE=0.01
MAX_CONCURRENT_POSITIONS=10

# Backtest costs
FEE_PER_LEG=0.0004
SLIPPAGE=0.0005
